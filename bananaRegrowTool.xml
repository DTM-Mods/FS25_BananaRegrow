<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Construction menu tile only (Shift-P > Landscaping > Banana Regrow): the brush marks an area and cuts back the
     banana plants in it, nothing is ever placed. simplePlaceable is a vanilla placeable type; the base i3d is only
     the store item requirement and is never loaded by the brush. -->
<placeable type="simplePlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_bananaRegrowTool</name>
        <functions>
            <function>$l10n_function_bananaRegrowTool</function>
        </functions>
        <image>store_bananaRegrow.dds</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <canBeSold>false</canBeSold>
        <showInStore>true</showInStore>
        <brush>
            <type>FS25_BananaRegrow.bananaRegrow</type>
            <category>landscaping</category>
            <tab>bananaRegrow</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/shared/assets/constructionCursorSimple.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <!-- never placed (see above); the empty sections only satisfy the GIANTS placeable checks -->
    <placement useRandomYRotation="false" useManualYRotation="false">
        <testAreas/>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>
    <clearAreas/>
    <leveling requireLeveling="false">
        <levelAreas/>
    </leveling>
    <indoorAreas/>
</placeable>
